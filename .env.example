# Server only. No credentials are needed in mock mode.
DATA_MODE=mock
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
# Legacy alternative when Google sign-in is not enabled. Username: differs
DASHBOARD_PASSWORD=
# Google sign-in (server-only). Set AUTH_MODE=google to require it.
AUTH_MODE=auto
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated, exact Google account email addresses. Empty denies all sign-ins.
AUTH_ALLOWED_EMAILS=
# Generate a random secret of at least 32 characters. Keep stable across deployments.
SESSION_PASSWORD=
# NUXT_DATA_MODE, NUXT_VERCEL_TOKEN, NUXT_VERCEL_TEAM_ID,
# NUXT_GITHUB_TOKEN and NUXT_DASHBOARD_PASSWORD are also supported.
# Auth variables also support the NUXT_ prefix (e.g. NUXT_GOOGLE_CLIENT_ID).
